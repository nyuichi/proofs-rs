{
  "name": "proofs-rs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/build-tool-docs.mjs --check && node --import tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy:staging": "node scripts/provision.mjs && wrangler d1 migrations apply DB --remote --config wrangler.staging.json && wrangler deploy --config wrangler.staging.json",
    "preview:build": "node --import tsx scripts/build-preview.ts && node scripts/check-preview.mjs dist/branch-preview.html"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "marked": "^17.0.6",
    "semver": "^7.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
