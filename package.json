{
  "name": "proofs-rs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build && npm run build:book",
    "build:book": "node scripts/build-book.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy:staging": "node scripts/provision.mjs && wrangler d1 migrations apply DB --remote --config wrangler.staging.json && wrangler deploy --config wrangler.staging.json"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.6",
    "hono": "^4.9.0",
    "hono-openapi": "^1.3.3",
    "semver": "^7.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.1.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
